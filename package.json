{
  "name": "arknights-basement",
  "version": "0.1.0",
  "description": "Arknights base rotation simulator",
  "private": true,
  "homepage": "https://arknights.damonge.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/big-mon/arknights-basement-simulator.git"
  },
  "bugs": {
    "url": "https://github.com/big-mon/arknights-basement-simulator/issues"
  },
  "author": "BIG_MON",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "pnpm test && pnpm build",
    "audit:base-skills": "node scripts/audit-base-skills.mjs",
    "audit:localization": "node scripts/audit-localization.mjs",
    "import:game-data": "node scripts/import-game-data.mjs",
    "import:wiki-localization": "node scripts/import-wiki-localization.mjs",
    "import:wikiru-ja-localization": "node scripts/import-wikiru-japanese-localization.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^27.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": "^24.21.0"
  },
  "packageManager": "pnpm@11.23.0"
}
